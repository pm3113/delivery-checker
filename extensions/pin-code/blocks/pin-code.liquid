<div class="pincode-checker">

  <div class="pincode-header">
    <h3>Check Delivery Availability</h3>
    <p>Enter your pincode to check delivery availability.</p>
  </div>

  <div class="pincode-field">
    <label for="pincode">Enter 6-digit Pincode</label>

    <input
      id="pincode"
      type="text"
      maxlength="6"
      inputmode="numeric"
      placeholder="Enter 6-digit Pincode"
      autocomplete="postal-code"
    >
  </div>

  <button
    id="check-btn"
    type="button"
  >
    Check Delivery
  </button>

  <div id="result"></div>

</div>

<style>

.pincode-checker {
  max-width: 500px;
  margin: 20px 0;
  padding: 24px;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.pincode-header h3 {
  margin: 0 0 6px;
  font-size: 22px;
  font-weight: 600;
}

.pincode-header p {
  margin: 0 0 20px;
  font-size: 14px;
  color: #666;
}

.pincode-field {
  margin-bottom: 14px;
}

.pincode-field label {
  display: block;
  margin-bottom: 7px;
  font-size: 14px;
  font-weight: 600;
}

.pincode-field input {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 16px;
}

.pincode-field input:focus {
  outline: none;
  border-color: #222;
}

#check-btn {
  width: 100%;
  padding: 13px 18px;
  border: none;
  border-radius: 6px;
  background: #222;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}

#check-btn:hover {
  opacity: 0.9;
}

#check-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

#result {
  margin-top: 20px;
  font-size: 15px;
}

.delivery-result {
  padding: 16px;
  border: 1px solid #d9d9d9;
  border-radius: 8px;
  background: #fafafa;
}

.delivery-title {
  margin-bottom: 14px;
  font-size: 17px;
  font-weight: 700;
}

.delivery-row {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 7px 0;
  border-bottom: 1px solid #eee;
}

.delivery-row:last-child {
  border-bottom: none;
}

.delivery-label {
  font-weight: 600;
}

.delivery-value {
  text-align: right;
}

.success {
  color: #16803c;
}

.error {
  color: #c62828;
}

.loading {
  color: #555;
}

</style>

<script>

document.addEventListener("DOMContentLoaded", function () {

  const btn = document.getElementById("check-btn");
  const pin = document.getElementById("pincode");
  const result = document.getElementById("result");

  if (!btn || !pin || !result) {
    return;
  }

  btn.addEventListener("click", async function () {

    const pincode = pin.value.trim();

    if (!/^\d{6}$/.test(pincode)) {

      result.innerHTML = `
        <div class="error">
          Please enter a valid 6-digit pincode.
        </div>
      `;

      return;
    }

    btn.disabled = true;
    btn.innerText = "Checking...";

    result.innerHTML = `
      <div class="loading">
        Checking delivery availability...
      </div>
    `;

    try {

      const response = await fetch(
        "https://api.glomore.in/api/delivery?pincode=" +
        encodeURIComponent(pincode)
      );

      if (!response.ok) {
        throw new Error("API request failed");
      }

      const apiData = await response.json();

      console.log("Pincode API response:", apiData);

      if (apiData.available && apiData.postOffice) {

        const postOffice = apiData.postOffice;

        result.innerHTML = `
          <div class="delivery-result">

            <div class="delivery-title success">
              ✓ Delivery Available
            </div>

            <div class="delivery-row">
              <span class="delivery-label">Pincode</span>
              <span class="delivery-value">
                ${apiData.pincode}
              </span>
            </div>

            <div class="delivery-row">
              <span class="delivery-label">Post Office</span>
              <span class="delivery-value">
                ${postOffice.name}
              </span>
            </div>

            <div class="delivery-row">
              <span class="delivery-label">District</span>
              <span class="delivery-value">
                ${postOffice.district}
              </span>
            </div>

            <div class="delivery-row">
              <span class="delivery-label">State</span>
              <span class="delivery-value">
                ${postOffice.state}
              </span>
            </div>

            <div class="delivery-row">
              <span class="delivery-label">Delivery Status</span>
              <span class="delivery-value">
                ${postOffice.deliveryStatus}
              </span>
            </div>

          </div>
        `;

      } else {

        result.innerHTML = `
          <div class="error">
            ✕ Delivery unavailable for this pincode.
          </div>
        `;

      }

    } catch (error) {

      console.error("Pincode API error:", error);

      result.innerHTML = `
        <div class="error">
          Unable to check delivery.
          Please try again.
        </div>
      `;

    } finally {

      btn.disabled = false;
      btn.innerText = "Check Delivery";

    }

  });

});

</script>

{% schema %}
{
  "name": "Pincode Checker",
  "target": "section",
  "settings": []
}
{% endschema %}