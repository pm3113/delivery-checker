<div class="pincode-checker">

  <h3>Check Delivery Availability</h3>

  <div class="field">
    <input
      class="field__input"
      id="pincode"
      type="text"
      maxlength="6"
      placeholder="Enter 6-digit Pincode"
    >

    <label class="field__label" for="pincode">
      Enter 6-digit Pincode
    </label>
  </div>

  <br>

  <button class="button button--primary" id="check-btn">
    Check Delivery
  </button>

  <br><br>

  <div id="result"></div>

</div>

<style>

.pincode-checker{
    border:1px solid #e5e5e5;
    padding:20px;
    border-radius:8px;
    margin-top:20px;
    background:#fafafa;
}

#result{
    margin-top:15px;
    font-size:15px;
    font-weight:600;
}

.success{
    color:green;
}

.error{
    color:red;
}

.loading{
    color:#444;
}

button:disabled{
    opacity:0.6;
    cursor:not-allowed;
}

</style>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const btn = document.getElementById("check-btn");
    const pin = document.getElementById("pincode");
    const result = document.getElementById("result");

    btn.addEventListener("click", async function () {

        const pincode = pin.value.trim();

        if (!/^\d{6}$/.test(pincode)) {
            result.innerHTML =
                "<span class='error'>Please enter a valid 6-digit pincode.</span>";
            return;
        }

        btn.disabled = true;
        btn.innerText = "Checking...";

        result.innerHTML =
            "<span class='loading'>Checking delivery availability...</span>";

        try {

            const response = await fetch(
                "http://32.198.46.211/api/delivery?pincode=" + pincode
            );

            if (!response.ok) {
                throw new Error("API request failed");
            }

            const data = await response.json();

            if (data.cheapest) {

                result.innerHTML = `
                    <div class="success">
                        ✅ Delivery available
                        <br><br>

                        <strong>Pincode:</strong> ${data.pincode}<br>

                        <strong>Cheapest Company:</strong>
                        ${data.cheapest.company}<br>

                        <strong>Delivery Price:</strong>
                        ₹${data.cheapest.price}<br>

                        <strong>Delivery Time:</strong>
                        ${data.cheapest.deliveryDays} days
                    </div>
                `;

            } else {

                result.innerHTML = `
                    <div class="error">
                        ✗ Delivery unavailable for this pincode.
                    </div>
                `;

            }

        } catch (error) {

            console.error(error);

            result.innerHTML = `
                <div class="error">
                    Unable to check delivery.
                    Please try again.
                </div>
            `;

        } finally {

            btn.disabled = false;
            btn.innerText = "Check Delivery";

        }

    });

});

</script>