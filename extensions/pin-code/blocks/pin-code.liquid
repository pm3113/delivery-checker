<div class="pincode-checker">

  <h3>Check Delivery Availability</h3>

  <div class="field">
    <input
      class="field__input"
      id="pincode"
      type="text"
      maxlength="6"
      inputmode="numeric"
      placeholder="Enter 6-digit Pincode"
    >

    <label class="field__label" for="pincode">
      Enter 6-digit Pincode
    </label>
  </div>

  <br>

  <button
    class="button button--primary"
    id="check-btn"
    type="button"
  >
    Check Delivery
  </button>

  <br><br>

  <div id="result"></div>

</div>

<style>

.pincode-checker {
  border: 1px solid #e5e5e5;
  padding: 20px;
  border-radius: 8px;
  margin-top: 20px;
  background: #fafafa;
}

.pincode-checker h3 {
  margin-top: 0;
  margin-bottom: 15px;
}

#result {
  margin-top: 15px;
  font-size: 15px;
  font-weight: 600;
}

.success {
  color: green;
}

.error {
  color: red;
}

.loading {
  color: #444;
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

</style>

<script>

document.addEventListener("DOMContentLoaded", function () {

  const btn = document.getElementById("check-btn");
  const pin = document.getElementById("pincode");
  const result = document.getElementById("result");

  if (!btn || !pin || !result) {
    return;
  }

  btn.addEventListener("click", async function () {

    const pincode = pin.value.trim();

    // Validate pincode
    if (!/^\d{6}$/.test(pincode)) {

      result.innerHTML = `
        <span class="error">
          Please enter a valid 6-digit pincode.
        </span>
      `;

      return;
    }

    // Disable button
    btn.disabled = true;
    btn.innerText = "Checking...";

    result.innerHTML = `
      <span class="loading">
        Checking delivery availability...
      </span>
    `;

    try {

      // Call AWS API
      const response = await fetch(
        "https://api.glomore.in/api/delivery?pincode=" +
        encodeURIComponent(pincode)
      );

      if (!response.ok) {
        throw new Error("API request failed");
      }

      const apiData = await response.json();

      console.log("Pincode API response:", apiData);

      // Delivery available
      if (apiData.available && apiData.postOffice) {

        const postOffice = apiData.postOffice;

        result.innerHTML = `
          <div class="success">

            <strong>Delivery available</strong>

            <br><br>

            <strong>Pincode:</strong>
            ${apiData.pincode}

            <br>

            <strong>Post Office:</strong>
            ${postOffice.name}

            <br>

            <strong>District:</strong>
            ${postOffice.district}

            <br>

            <strong>State:</strong>
            ${postOffice.state}

            <br>

            <strong>Delivery Status:</strong>
            ${postOffice.deliveryStatus}

          </div>
        `;

      } else {

        // Delivery unavailable
        result.innerHTML = `
          <div class="error">
            Delivery unavailable for this pincode.
          </div>
        `;

      }

    } catch (error) {

      console.error("Pincode API error:", error);

      result.innerHTML = `
        <div class="error">
          Unable to check delivery.
          Please try again.
        </div>
      `;

    } finally {

      // Enable button again
      btn.disabled = false;
      btn.innerText = "Check Delivery";

    }

  });

});

</script>

{% schema %}
{
  "name": "Pincode Checker",
  "target": "section",
  "settings": []
}
{% endschema %}